<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <portfolio_erp_sync>
            <general>
                <enabled>1</enabled>
                <cron_enabled>0</cron_enabled>
            </general>
            <api>
                <base_url>http://mock-erp-api:3001</base_url>
                <token>dev-erp-token</token>
                <timeout>15</timeout>
                <page_size>25</page_size>
            </api>
        </portfolio_erp_sync>
    </default>
</config>

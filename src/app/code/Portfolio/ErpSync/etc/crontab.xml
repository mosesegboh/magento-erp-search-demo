<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="portfolio_erp_sync_products" instance="Portfolio\ErpSync\Cron\SyncProducts" method="execute">
            <schedule>*/15 * * * *</schedule>
        </job>
        <job name="portfolio_erp_sync_retry_due" instance="Portfolio\ErpSync\Cron\RetryDueSyncProducts" method="execute">
            <schedule>*/5 * * * *</schedule>
        </job>
    </group>
</config>

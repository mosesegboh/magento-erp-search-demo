<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="portfolio_order_export_log" resource="default" engine="innodb" comment="Portfolio Order Export Log">
        <column xsi:type="int" name="log_id" unsigned="true" nullable="false" identity="true" comment="Log ID"/>
        <column xsi:type="int" name="order_id" unsigned="true" nullable="false" comment="Order Entity ID"/>
        <column xsi:type="varchar" name="increment_id" nullable="false" length="50" comment="Order Increment ID"/>
        <column xsi:type="varchar" name="status" nullable="false" length="32" comment="Export Status"/>
        <column xsi:type="varchar" name="external_id" nullable="true" length="64" comment="ERP External ID"/>
        <column xsi:type="varchar" name="idempotency_key" nullable="false" length="128" comment="Idempotency Key"/>
        <column xsi:type="int" name="attempts" unsigned="true" nullable="false" default="0" comment="Attempt Count"/>
        <column xsi:type="text" name="request_payload" nullable="true" comment="Request Payload JSON"/>
        <column xsi:type="text" name="response_payload" nullable="true" comment="Response Payload JSON"/>
        <column xsi:type="text" name="context" nullable="true" comment="Context JSON"/>
        <column xsi:type="text" name="message" nullable="true" comment="Message"/>
        <column xsi:type="timestamp" name="next_retry_at" nullable="true" comment="Next Retry At"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="log_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="PORTFOLIO_ORDER_EXPORT_LOG_ORDER_ID">
            <column name="order_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="PORTFOLIO_ORDER_EXPORT_LOG_IDEMPOTENCY_KEY">
            <column name="idempotency_key"/>
        </constraint>
        <index referenceId="PORTFOLIO_ORDER_EXPORT_LOG_STATUS" indexType="btree">
            <column name="status"/>
        </index>
        <index referenceId="PORTFOLIO_ORDER_EXPORT_LOG_INCREMENT_ID" indexType="btree">
            <column name="increment_id"/>
        </index>
        <index referenceId="PORTFOLIO_ORDER_EXPORT_LOG_STATUS_NEXT_RETRY_AT" indexType="btree">
            <column name="status"/>
            <column name="next_retry_at"/>
        </index>
    </table>
</schema>
